                    <p>support@mediscanai.com</p>
                </div>
                <div class="contact-card">
                    <div class="c-icon">📍</div>
                    <h4>Location</h4>
                    <p>India</p>
                </div>
                <div class="contact-card">
                    <div class="c-icon">🚀</div>

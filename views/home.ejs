<%- include("partials/header") %>
    <%- include("partials/navbar") %>

        <!-- ================= HERO SECTION ================= -->

        <section class="hero">
            <div class="hero-content">
                <h1>AI Medical Report Analyzer</h1>
                <p class="hero-subtitle">
                    Understand your medical reports in simple language — with dual explanation modes,
                    smart doctor guidance, and regional voice support.
                </p>

                <div class="hero-buttons">
                    <a href="/upload" class="primary-btn">Analyze My Report</a>
                    <a href="#how-it-works" class="btn-secondary">
                        See How It Works
                    </a>

                </div>
            </div>
        </section>

        <!-- ================= PROBLEM SECTION ================= -->
        <section class="problem-section">
            <div class="problem-container">

                <!-- LEFT SIDE -->
                <div class="problem-left">

                    <h2>Understanding Medical Reports Shouldn’t Feel Overwhelming</h2>

                    <p class="problem-intro">
                        Medical reports are often filled with technical terminology,
                        unfamiliar abbreviations, and confusing numbers.
                        What should provide clarity often creates anxiety instead.
                    </p>

                    <div class="problem-grid">

                        <div class="problem-card">
                            <div class="problem-icon">📄</div>
                            <h3>Complex Medical Jargon</h3>
                            <p>
                                Reports include lab values and medical terms that
                                are difficult to interpret without professional knowledge.
                            </p>
                        </div>

                        <div class="problem-card">
                            <div class="problem-icon">😟</div>
                            <h3>Uncertainty & Anxiety</h3>
                            <p>
                                Patients often wonder:
                                “Is this serious? Should I see a doctor immediately?”
                            </p>
                        </div>

                        <div class="problem-card">
                            <div class="problem-icon">👵</div>
                            <h3>Accessibility Barriers</h3>
                            <p>
                                Elderly individuals and caregivers struggle
                                with medical and language complexity.
                            </p>
                        </div>

                        <div class="problem-card">
                            <div class="problem-icon">⏳</div>
                            <h3>Delayed Clarity</h3>
                            <p>
                                Many wait days for a consultation just to
                                understand what their own report means.
                            </p>
                        </div>

                    </div>
                </div>

                <!-- RIGHT SIDE IMAGE -->
                <div class="problem-right">
                    <img src="/images/medical-report-confusion.jpeg " alt="Confused patient looking at medical report">
                </div>

            </div>
        </section>

        <!-- ================= SOLUTION SECTION ================= -->
        <section class="solution-section">
            <div class="solution-container">

                <!-- LEFT IMAGE -->
                <div class="solution-left">
                    <img src="/images/ai-medical-solution.png" alt="AI analyzing medical report">
                </div>

                <!-- RIGHT CONTENT -->
                <div class="solution-right">

                    <h2>Turning Confusion Into Clear, Actionable Insight</h2>

                    <p class="solution-intro">
                        Mediscan AI transforms complex medical reports into
                        structured, easy-to-understand explanations — while
                        maintaining clinical depth when needed.
                    </p>

                    <div class="solution-grid">

                        <div class="solution-card">
                            <div class="solution-icon">📄</div>
                            <h3>Smart Report Analysis</h3>
                            <p>
                                AI extracts lab values, detects abnormalities,
                                and interprets them in context.
                            </p>
                        </div>

                        <div class="solution-card">
                            <div class="solution-icon">🔁</div>
                            <h3>Dual Explanation Modes</h3>
                            <p>
                                Choose between Patient Mode (simple) and
                                Medical Mode (clinical depth).
                            </p>
                        </div>

                        <div class="solution-card">
                            <div class="solution-icon">🚦</div>
                            <h3>Doctor Visit Indicator</h3>
                            <p>
                                Clear risk levels to guide whether
                                monitoring or consultation is recommended.
                            </p>
                        </div>

                        <div class="solution-card">
                            <div class="solution-icon">🎤</div>
                            <h3>Voice & Language Support</h3>
                            <p>
                                Hear your report explained aloud
                                in accessible language.
                            </p>
                        </div>

                    </div>

                </div>

            </div>
        </section>

        <!-- ================= HOW IT WORKS ================= -->

        <section id="how-it-works" class="how-it-works">
            <div class="how-container">
                <h1>How it Works</h1>
                <p class="how-sub">From Upload to Understanding in 4 Simple Steps</p>

                <div class="steps-wrapper">

                    <!-- STEP 1 -->
                    <div class="step-card step-blue">
                        <div class="icon">📄</div>
                        <div class="step-pill blue-pill">Step 1: Upload Your Report</div>
                        <p>
                            Simply upload your medical report (PDF, image, or scanned document).
                            Works with lab reports, radiology findings, prescriptions and more.
                        </p>
                    </div>

                    <!-- STEP 2 -->
                    <div class="step-card step-green">
                        <div class="icon">🎯</div>
                        <div class="step-pill green-pill">Step 2: Choose Your Mode</div>
                        <p>
                            Select how you'd like your explanation:
                            <br><br>
                            • Patient Mode – Simple language
                            <br>
                            • Medical Mode – Clinical terminology
                        </p>
                    </div>

                    <!-- STEP 3 -->
                    <div class="step-card step-orange">
                        <div class="icon">🤖</div>
                        <div class="step-pill orange-pill">Step 3: AI Analysis</div>
                        <p>
                            Our AI extracts values, analyzes parameters,
                            and generates explanations in your preferred
                            language and complexity level.
                        </p>
                    </div>

                    <!-- STEP 4 -->
                    <div class="step-card step-purple">
                        <div class="icon">✔</div>
                        <div class="step-pill purple-pill">Step 4: Get Your Insights</div>
                        <p>
                            Receive:
                            <br><br>
                            • Clear explanations
                            <br>
                            • Risk indicators
                            <br>
                            • Shareable summary cards
                        </p>
                    </div>

                </div>

                <p class="bottom-line">
                    No diagnosis. No medical jargon overload. Just clarity.
                </p>
            </div>
        </section>


        <!-- ================= SAFETY ================= -->
        <section class="safety-section">
            <div class="safety-container">

                <h2>Safety & Ethics</h2>
                <p class="safety-sub">
                    Built responsibly. Designed for clarity — not diagnosis.
                </p>

                <div class="safety-cards">

                    <div class="safety-card">
                        <div class="safety-icon">🛑</div>
                        <h3>No Medical Diagnosis</h3>
                        <p>
                            This platform provides educational explanations,
                            not clinical diagnoses or treatment plans.
                        </p>
                    </div>

                    <div class="safety-card">
                        <div class="safety-icon">🔐</div>
                        <h3>Your Data Stays Private</h3>
                        <p>
                            Reports are processed securely and are not
                            permanently stored without user consent.
                        </p>
                    </div>

                    <div class="safety-card">
                        <div class="safety-icon">⚖</div>
                        <h3>Assistive, Not Prescriptive</h3>
                        <p>
                            We guide understanding and encourage consultation
                            with licensed healthcare professionals when needed.
                        </p>
                    </div>

                </div>

            </div>
        </section>


        <!-- ================= FINAL CTA ================= -->

        <section class="cta-section">
            <div class="cta-container">

                <h2>Take Control of Your Health Reports Today</h2>

                <p class="cta-subtext">
                    Upload a medical report and receive clear explanations,
                    structured insights, and smart guidance — in seconds.
                </p>

                <div class="cta-buttons">
                    <a href="/upload" class="btn-primary">Analyze My Report</a>
                    <a href="/features" class="btn-secondary">Explore Features</a>
                </div>

                <p class="cta-note">
                    No data stored. Educational & assistive purpose only.
                </p>

            </div>
        </section>

        <script>
            document.querySelector('.btn-secondary').addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector('#how-it-works').scrollIntoView({
                    behavior: 'smooth'
                });
            });
        </script>

        <%- include("partials/footer") %>